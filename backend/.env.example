# CorridorOps — Environment Variables Example
# Copy this file to .env and replace placeholder values with real ones.
# NEVER commit .env with real credentials to version control.

# ─── Application ────────────────────────────────────────────────────────────
# JWT secret key — use a long, random, unique string in production
SECRET_KEY=your-super-secret-jwt-key-replace-this-in-production

# JWT algorithm
ALGORITHM=HS256

# Access token expiry in minutes (default: 10080 = 7 days)
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ─── Database ─────────────────────────────────────────────────────────────
# SQLite (local development — default if not set)
# DATABASE_URL=sqlite+aiosqlite:///./corridorops.db

# PostgreSQL + PostGIS (Docker / production)
DATABASE_URL=postgresql+asyncpg://corridor_user:corridor_password@localhost:5432/corridorops_db

# ─── Notes ──────────────────────────────────────────────────────────────────
# For Docker Compose, DATABASE_URL is set via the docker-compose.yml environment block.
# The backend uses aiosqlite for local dev and asyncpg for PostgreSQL.
# Do NOT include real API keys, passwords, or database credentials in this file.
